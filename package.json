{
  "name": "lemon-admin",
  "version": "0.0.0",
  "private": true,
  "description": "A full-stack monorepo project built with NestJS (backend) and React (admin dashboard)",
  "keywords": [
    "admin-dashboard",
    "monorepo",
    "nestjs",
    "react",
    "turborepo",
    "typescript",
    "vite",
    "web"
  ],
  "homepage": "https://github.com/sankeyangshu/lemon-admin#readme",
  "bugs": {
    "url": "https://github.com/sankeyangshu/lemon-admin/issues"
  },
  "license": "MIT",
  "author": {
    "name": "sankeyangshu",
    "email": "sankeyangshu@gmail.com",
    "url": "https://github.com/sankeyangshu"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sankeyangshu/lemon-admin.git"
  },
  "scripts": {
    "build": "turbo build",
    "clean": "turbo run clean",
    "dev": "turbo dev",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "preinstall": "npx only-allow pnpm",
    "prepare": "simple-git-hooks",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:dev",
    "@commitlint/config-conventional": "catalog:dev",
    "lint-staged": "catalog:dev",
    "oxfmt": "catalog:dev",
    "oxlint": "catalog:dev",
    "simple-git-hooks": "catalog:dev",
    "turbo": "catalog:dev",
    "typescript": "catalog:core"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged --concurrent false",
    "commit-msg": "pnpm exec commitlint --edit \"$1\""
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern",
    "*.{js,jsx,ts,tsx,mjs,cjs}": "pnpm run lint"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@12.3.4"
}
